    elementType: table
    bounds: [80, 460, 1120, 180]
    columnWidths: [0.25, 0.15, 0.20, 0.40]
    rowHeights: [0.25, 0.25, 0.25, 0.25]
    style: "$default"
    rows:
      - - content:
            text: |
              <p>投向板块</p>
        - content:
            text: |
              <p>占比</p>
        - content:
            text: |
              <p>对应金额</p>
        - content:
            text: |
              <p>核心用途</p>
      - - content:
            text: |
