pageType: final
background:
  type: solid
  color: "$background"
elements:
  - elementId: bg-img
    elementType: image
    bounds: [0, 0, 1280, 720]
    src: "https://images.unsplash.com/photo-1518770660439-4636190af475?w=1920"
    fit:
      mode: cover
  - elementId: bg-mask
    elementType: shape
    bounds: [0, 0, 1280, 720]
    shapeName: rect
    fill:
      type: gradient
      gradientType: linear
      angle: 90
      stops:
        - {position: 0, color: "#0A0A0A33"}
        - {position: 0.4, color: "#0A0A0ACC"}
        - {position: 1, color: "#0A0A0A"}
  - elementId: top-line
    elementType: shape
    bounds: [540, 240, 200, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 2, color: "$primary"}
  - elementId: thanks-text
    elementType: text
    bounds: [240, 270, 800, 60]
    content:
      fontSize: 48
      color: "$text"
      fontFamily: "Liter, alimamashuheiti"
      align: [center, middle]
      wrap: false
      text: |
        <p>感谢聆听</p>
  - elementId: slogan-text
    elementType: text
    bounds: [190, 350, 900, 40]
    content:
      fontSize: 22
      color: "$secondary"
      fontFamily: "Liter, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        <p>以 AI + AM 重构特种装备保障新范式</p>
  - elementId: bottom-line
    elementType: shape
    bounds: [540, 410, 200, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 2, color: "$primary"}
  - elementId: placeholder-text
    elementType: text
    bounds: [340, 560, 600, 80]
    content:
      fontSize: 16
      color: "$secondary"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.6
      align: [center, middle]
      text: |
        <p>（参赛主体与联系方式待补充）</p>
