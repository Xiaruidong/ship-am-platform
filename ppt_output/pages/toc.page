pageType: table_of_contents
background:
  type: solid
  color: "$background"
elements:
  - elementId: left-title
    elementType: text
    bounds: [80, 220, 400, 80]
    content:
      fontSize: 72
      color: "$primary"
      fontFamily: "Liter"
      lineHeight: 1.0
      align: [left, middle]
      wrap: false
      text: |
        <p>CONTENTS</p>
  - elementId: left-line
    elementType: shape
    bounds: [80, 310, 60, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 3, color: "$primary"}
