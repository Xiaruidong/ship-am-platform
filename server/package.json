    "test-data:clean": "node --import tsx db/test-data.mjs --clean"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
